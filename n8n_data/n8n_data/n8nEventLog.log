 writing\\nExperiencia laboral: [{\\\"company\\\":\\\"Unidad Educativa Fiscomisional Salesiana Sánchez y Cifuentes\\\",\\\"role\\\":\\\"Chemistry club instructor\\\",\\\"duration\\\":\\\"April-June 2023\\\"},{\\\"company\\\":\\\"Yachay Tech University\\\",\\\"role\\\":\\\"Research assistant\\\",\\\"duration\\\":\\\"July-September 2022\\\"},{\\\"company\\\":\\\"Yachay Tech University\\\",\\\"role\\\":\\\"Undergraduate researcher\\\",\\\"duration\\\":\\\"2024-2025\\\"},{\\\"company\\\":\\\"HAWSEN\\\",\\\"role\\\":\\\"Associate researcher\\\",\\\"duration\\\":\\\"March 2021 – March 2022\\\"},{\\\"company\\\":\\\"LangosMar (Shrimp Packing Plant)\\\",\\\"role\\\":\\\"Process Supervisor\\\",\\\"duration\\\":\\\"June 2026\\\"}]\\nEducación: [{\\\"degree\\\":\\\"Bachelor's Degree in Chemistry\\\",\\\"institution\\\":\\\"Yachay Tech University\\\",\\\"year\\\":\\\"2025\\\"},{\\\"degree\\\":\\\"High School Diploma in Sciences (International Baccalaureate)\\\",\\\"institution\\\":\\\"Unidad Educativa Ancón\\\",\\\"year\\\":\\\"2018\\\"}]\"],\"options\":{\"openai_api_key\":{\"lc\":1,\"type\":\"secret\",\"id\":[\"OPENAI_API_KEY\"]},\"model\":\"deepseek-v4-flash\",\"max_retries\":2,\"configuration\":{\"baseURL\":\"https://api.deepseek.com\",\"fetchOptions\":{\"dispatcher\":{\"_events\":{},\"_eventsCount\":0}}},\"model_kwargs\":{}},\"response\":{\"response\":{\"generations\":[[{\"text\":\"{\\n  \\\"classification\\\": \\\"semi-senior\\\",\\n  \\\"classification_reason\\\": \\\"Con 2.5 años de experiencia relevante en investigación y laboratorio, con habilidades técnicas amplias y profundas en química de materiales y métodos analíticos, cumple con el rango de 2 a 5 años para semi-senior.\\\"\\n}\",\"generationInfo\":{\"finish_reason\":\"stop\"}}]]},\"tokenUsage\":{\"completionTokens\":264,\"promptTokens\":594,\"totalTokens\":858}}}"}}
