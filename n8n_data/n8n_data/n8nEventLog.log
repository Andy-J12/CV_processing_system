",\\\"duration\\\":\\\"1 año\\\"},{\\\"company\\\":\\\"TRABAJOS VARIOS\\\",\\\"role\\\":\\\"Niñera\\\",\\\"duration\\\":\\\"1 año\\\"}]\\nEducación: [{\\\"degree\\\":\\\"BGU\\\",\\\"institution\\\":\\\"COLEGIO VIRTUAL INTENSIVO PCEI RAFAEL GALETH\\\",\\\"year\\\":null}]\"],\"options\":{\"openai_api_key\":{\"lc\":1,\"type\":\"secret\",\"id\":[\"OPENAI_API_KEY\"]},\"model\":\"deepseek-v4-flash\",\"max_retries\":2,\"configuration\":{\"baseURL\":\"https://api.deepseek.com\",\"fetchOptions\":{\"dispatcher\":{\"_events\":{},\"_eventsCount\":0}}},\"model_kwargs\":{}},\"response\":{\"response\":{\"generations\":[[{\"text\":\"{\\n  \\\"classification\\\": \\\"junior\\\",\\n  \\\"classification_reason\\\": \\\"Aunque acumula casi 6 años de experiencia laboral total, sus roles son variados y de nivel básico (cocina, atención al cliente, contabilidad auxiliar, ventas, niñera), sin especialización técnica ni liderazgo. Su experiencia relevante en cocina suma menos de 2 años, lo que la clasifica como junior.\\\"\\n}\",\"generationInfo\":{\"finish_reason\":\"stop\"}}]]},\"tokenUsage\":{\"completionTokens\":360,\"promptTokens\":462,\"totalTokens\":822}}}"}}
