,\"model\":\"deepseek-v4-flash\",\"max_retries\":2,\"configuration\":{\"baseURL\":\"https://api.deepseek.com\",\"fetchOptions\":{\"dispatcher\":{\"_events\":{},\"_eventsCount\":0}}},\"model_kwargs\":{}},\"response\":{\"response\":{\"generations\":[[{\"text\":\"{\\n  \\\"classification\\\": \\\"junior\\\",\\n  \\\"classification_reason\\\": \\\"Cuenta con aproximadamente 1 año de experiencia laboral real (freelance junior) y aún está cursando estudios; el rol de pasante es futuro o reciente, por lo que no supera los 2 años de experiencia relevante.\\\"\\n}\",\"generationInfo\":{\"finish_reason\":\"stop\"}}]]},\"tokenUsage\":{\"completionTokens\":288,\"promptTokens\":367,\"totalTokens\":655}}}"}}
